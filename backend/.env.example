# Copiá este archivo como ".env" y completá tus datos (el .env NO se sube a GitHub)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/club_db

# Ruta al JSON de la cuenta de servicio de Firebase (para correr en tu PC)
FIREBASE_CREDENTIALS_FILE=firebase-credentials.json
# En Render: pegá acá TODO el contenido del JSON (y dejá la línea de arriba vacía)
# FIREBASE_CREDENTIALS_JSON=

# Solo para obtener_token.py (Configuración del proyecto > General > Clave de API web)
FIREBASE_WEB_API_KEY=

# Recordatorios push cada 5 minutos
ENABLE_SCHEDULER=true

# Único usuario administrador: el correo con el que se registra en la app
ADMIN_EMAIL=

# Carga sedes/deportes/canchas al iniciar si la base está vacía (útil en Render)
AUTO_SEED=false
